# ============================================================
# This repository mirrors the submission: the report PDF, the source code,
# and the auxiliary files the code and the report actually need. The process
# notes, the course material, the report build chain, the self-check scripts
# and the dataset itself are kept locally and are not committed (the report
# PDF and the code archive are the exceptions, see the end of this file).
#
# Naming rule: to exclude a directory, always write "dir/*", never "dir/".
# git never descends into an excluded directory, so a rule written as "docs/"
# or "data/" also kills every later ! re-include rule. Exclude the directory,
# then re-include the files you want.
# ============================================================

# ---- process notes and course material ----
progress/
plans/
AGENTS.md
# keep only the figure directory under docs/; the report build chain and the
# self-check scripts are local tools
docs/*
!docs/figures/

# ---- report build chain and self-check scripts (local only, not shipped) ----
docs/make_report.py
docs/report_template.tex
docs/check_crossrefs.py
docs/check_fold_claims.py
docs/acceptance_check.py
*.tex

# ---- LaTeX intermediates and the archive built for submission ----
*.aux
*.out
*.toc
*.lof
*.lot
*.log
logs/
Assignment2_Code_*.zip

# ---- the dataset itself: shipped through the cloud drive, see DATASET_LINK.txt ----
# Exclude data/ as a whole first, then re-include annotations/; otherwise git
# never enters the directory and the annotation CSVs are dropped with it.
data/*
!data/annotations/
# under annotations/ keep only the split file, the count summary and the
# manifests; review/ holds the rejected photographs and is not shipped.
data/annotations/*
!data/annotations/*.csv
!data/annotations/*.md
!data/annotations/inside/
!data/annotations/outside/

# ---- model artefacts: only the one locked pipeline is kept ----
models/*
!models/task3_pipeline.joblib
*.pkl
*.sav
*.h5
*.npy
*.npz
*.onnx

# ---- result tables: the raw data the report quotes, shipped with the code ----
# run_stamp.json must ship. It records which revision of the source produced
# these tables; without it a reader who runs the commands in the report hits
# "run_stamp.json is missing, refusing to resume" first. The fingerprint itself
# is only a sha256 of splits.csv plus src/task3, and carries nothing else.
outputs/*
!outputs/task3/

# ---- photographs are not committed; the repository keeps only report figures ----
*.jpg
*.jpeg
*.heic
*.heif
*.png
!docs/figures/*.png

# ---- feature caches and run directories ----
cache/
*.cache
features/
runs/
wandb/
mlruns/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---- editor and system files ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
~$*

# ---- submission directory: the report PDF and the archive stay local ----
submission/
